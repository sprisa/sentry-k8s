{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sentry-k8s Helm Chart Values",
  "description": "Helm chart for deploying Sentry self-hosted on Kubernetes",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": {
          "type": "string",
          "description": "Default storageClass for all bundled stateful workloads"
        },
        "nodeSelector": {
          "type": "object",
          "description": "Default nodeSelector applied to chart-owned workloads"
        },
        "kafkaMaxPollIntervalMs": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer", "minimum": 1 }
          ],
          "description": "Kafka max poll interval in ms applied to all consumers (default: 300000)"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "revisionHistoryLimit": { "type": "integer" },
    "extraManifests": {
      "type": "array"
    },
    "images": {
      "type": "object",
      "properties": {
        "sentry": { "$ref": "#/properties/images/properties/snuba" },
        "snuba": { "$ref": "#/properties/images/properties/relay" },
        "relay": { "$ref": "#/properties/images/properties/busybox" },
